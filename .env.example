# LinkedIn Authentication Cookies
# Copy this file to ~/.hermes/linkedin-auth.env and fill in your values.
#
# HOW TO GET YOUR COOKIES:
# 1. Open LinkedIn in Chrome or Firefox
# 2. Log in to your account
# 3. Press F12 to open DevTools
# 4. Go to Application (Chromium) or Storage (Firefox)
# 5. Find Cookies > https://www.linkedin.com
# 6. Copy the value of "li_at"
# 7. Copy the value of "JSESSIONID" (it may start with "ajax:")
#
# See README.md for full step-by-step instructions.

export LINKEDIN_LI_AT="YOUR_LI_AT_COOKIE_HERE"
export LINKEDIN_JSESSIONID="YOUR_JSESSIONID_COOKIE_HERE"
